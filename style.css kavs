body { 
    margin: 0; 
    font-family: Arial, sans-serif; 
    background-color: white; 
    color: #333; 
} 
nav { 
    background-color: #0b4f9c; 
    color: white; 
    padding: 15px 50px; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
}
 nav h2 { 
    margin: 0; 

} 
nav ul {
    list-style-type: none; 
    display: flex; 
    gap: 25px; 
}
 nav a { color: white; 
    text-decoration: none; 
}
 nav a:hover { 
    
    color: #b9dcff; 
}
 
